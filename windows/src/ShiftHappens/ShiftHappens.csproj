<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the Mac and Linux CI compile it; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ShiftHappens</AssemblyName>
    <RootNamespace>ShiftHappens</RootNamespace>
    <ApplicationIcon>..\..\..\packaging\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>Shift Happens</Product>
    <Company>Elaad Adar</Company>
    <!-- The release workflow passes -p:Version from the tag. -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\packaging\app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShiftCore\ShiftCore.csproj" />
  </ItemGroup>

</Project>
